{
  "manifest_version": 3,
  "name": "Video Summarizer",
  "version": "1.0.0",
  "description": "Summarize the YouTube video you're watching with your local Video Summarizer.",
  "key": "",
  "permissions": ["nativeMessaging", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Summarize this video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
